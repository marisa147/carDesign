# carAgent local development environment.
# These values are local-only examples. Do not use them for production.

RUNTIME_MODE=local

# Local application ports
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caragent
POSTGRES_USER=caragent
POSTGRES_PASSWORD=caragent_local_password
DATABASE_URL=postgresql+asyncpg://caragent:caragent_local_password@localhost:5432/caragent

# Redis broker/cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-compatible object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=caragent_minio
MINIO_ROOT_PASSWORD=caragent_minio_local_password
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=caragent_minio
S3_SECRET_ACCESS_KEY=caragent_minio_local_password
S3_BUCKET=caragent-local
S3_REGION=us-east-1

# Generation defaults. Local mode uses deterministic image generation.
# Phase 9 hosted BFL smoke is manual-only: set the V2 flag, provider, model,
# calls flag, real API key, and quota/rate/cost guards in an ignored env file.
AI_PROVIDER_DEFAULT=disabled
AI_PROVIDER_MODEL=local-concept-v1
AI_PROVIDER_CALLS_ENABLED=false
AI_GENERATION_TIMEOUT_SECONDS=30
AI_GENERATION_POLL_INTERVAL_SECONDS=1
AI_GENERATION_MAX_POLL_ATTEMPTS=30
AI_GENERATION_MAX_ATTEMPTS=1
AI_PROVIDER_FALLBACK_ENABLED=false
AI_PROVIDER_FALLBACK_NAME=local-deterministic
AI_HOSTED_DAILY_CALL_LIMIT=
AI_HOSTED_RATE_LIMIT_PER_MINUTE=
AI_MAX_ESTIMATED_COST_PER_JOB=
AI_LOCAL_IMAGE_WIDTH=1536
AI_LOCAL_IMAGE_HEIGHT=768
AI_PROVIDER_BFL_BASE_URL=http://127.0.0.1:8080/v1
AI_PROVIDER_BFL_SUBMIT_PATH=/v1/flux-2-pro-preview
AI_PROVIDER_BFL_RESULT_PATH=/v1/get_result
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_OPENAI_IMAGE_PATH=/images/generations
AI_PROVIDER_OPENAI_RESPONSES_PATH=/responses
AI_PROVIDER_OPENAI_TEXT_MODEL=gpt-5.5
AI_BRIEF_PARSER_PROVIDER=deterministic
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_FAL_API_KEY=
AI_PROVIDER_BFL_API_KEY=

# Example manual hosted-provider smoke overrides, keep commented by default.
# V2_HOSTED_PROVIDER_ROLLOUT_ENABLED=true
# AI_PROVIDER_DEFAULT=bfl
# AI_PROVIDER_MODEL=flux-2-pro-preview
# AI_PROVIDER_CALLS_ENABLED=true
# AI_HOSTED_DAILY_CALL_LIMIT=1
# AI_HOSTED_RATE_LIMIT_PER_MINUTE=1
# AI_MAX_ESTIMATED_COST_PER_JOB=0.25
# AI_PROVIDER_BFL_API_KEY=replace-with-real-key-in-ignored-env

# V2 flags. All V2 capabilities stay disabled by default.
V2_HOSTED_PROVIDER_ROLLOUT_ENABLED=false
V2_TARGETED_REGENERATION_ENABLED=false
V2_REFERENCE_GUIDANCE_ENABLED=false
V2_LIGHTWEIGHT_3D_PREVIEW_ENABLED=false
V2_ENHANCED_HANDOFF_PACKAGE_ENABLED=false
NEXT_PUBLIC_V2_HOSTED_PROVIDER_ROLLOUT_ENABLED=false
NEXT_PUBLIC_V2_TARGETED_REGENERATION_ENABLED=false
NEXT_PUBLIC_V2_REFERENCE_GUIDANCE_ENABLED=false
NEXT_PUBLIC_V2_LIGHTWEIGHT_3D_PREVIEW_ENABLED=false
NEXT_PUBLIC_V2_ENHANCED_HANDOFF_PACKAGE_ENABLED=false
AI_PROVIDER_OPENAI_IMAGE_MODEL=gpt-image-2
