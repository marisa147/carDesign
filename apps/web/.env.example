# carAgent web shell local environment.
# Browser-exposed values must use NEXT_PUBLIC_* only.

RUNTIME_MODE=local
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RUNTIME_MODE=local

# Phase 8 V2 readiness flags. Browser-visible flags are non-secret capability switches.
NEXT_PUBLIC_V2_HOSTED_PROVIDER_ROLLOUT_ENABLED=false
NEXT_PUBLIC_V2_TARGETED_REGENERATION_ENABLED=false
NEXT_PUBLIC_V2_REFERENCE_GUIDANCE_ENABLED=false
NEXT_PUBLIC_V2_LIGHTWEIGHT_3D_PREVIEW_ENABLED=false
NEXT_PUBLIC_V2_ENHANCED_HANDOFF_PACKAGE_ENABLED=false
